// Resources of the Windows application.
//
// ID 1, not 101: for the icon in Explorer and the taskbar, Windows uses the
// icon with the LOWEST ID in the exe. A higher number would still be in the
// file, but would not show up as the program icon.
//
// gui/main_win32.cpp loads the same ID. If either of the two places is
// changed, tools/check_win32.py reports it during the build.
#define IDI_G2C 1

IDI_G2C ICON "g2c.ico"

// --- Version information ----------------------------------------------------
//
// Not decoration, but a necessity.
//
// Since 2015, Windows Defender no longer works with fixed signatures only
// but with a predictive model: an unknown file can be flagged purely for
// being "suspicious", without resembling any known malware. An exe WITHOUT
// origin information is the worst possible starting point - it looks like
// something that wants to hide where it came from.
//
// This does not replace a signature, but it costs nothing and takes one
// clue away from the heuristic model.

#include <windows.h>

// Generated by CMake from assets/g2c_version.h.in: G2C_VER_* and G2C_VERSION.
#include "g2c_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    G2C_VER_MAJOR,G2C_VER_MINOR,G2C_VER_PATCH,G2C_VER_BUILD
 PRODUCTVERSION G2C_VER_MAJOR,G2C_VER_MINOR,G2C_VER_PATCH,G2C_VER_BUILD
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704b0"          // German, Unicode
        BEGIN
            VALUE "CompanyName",      "g2c"
            VALUE "FileDescription",  "g2c - Ghoul2 Toolkit fuer Jedi Academy"
            VALUE "FileVersion",      G2C_VER_STR
            VALUE "InternalName",     "g2c"
            VALUE "OriginalFilename", "g2c.exe"
            VALUE "ProductName",      "g2c - Ghoul2 Toolkit"
            VALUE "ProductVersion",   G2C_VERSION
            VALUE "Comments",         "Baut und zerlegt Ghoul2-Animationen (.gla) und Modelle (.glm)."
        END
        BLOCK "040904b0"          // English, Unicode
        BEGIN
            VALUE "CompanyName",      "g2c"
            VALUE "FileDescription",  "g2c - Ghoul2 Toolkit for Jedi Academy"
            VALUE "FileVersion",      G2C_VER_STR
            VALUE "InternalName",     "g2c"
            VALUE "OriginalFilename", "g2c.exe"
            VALUE "ProductName",      "g2c - Ghoul2 Toolkit"
            VALUE "ProductVersion",   G2C_VERSION
            VALUE "Comments",         "Builds and extracts Ghoul2 animations (.gla) and models (.glm)."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x407, 1200, 0x409, 1200
    END
END
