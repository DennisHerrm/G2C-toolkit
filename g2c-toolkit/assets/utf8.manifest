<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Paths with umlauts.

  The UI receives paths from Windows as UTF-16 and passes them on as UTF-8;
  the library opens files via std::string. Without this setting, Windows
  interprets such strings in the ANSI code page, and "Schuesse Blocken"
  spelled with an umlaut turned into "SchÃ¼sse" - file not found, or worse:
  the build created a second, wrongly named folder.

  With activeCodePage UTF-8 (Windows 10 1903 and later), all narrow Windows
  APIs of the process are UTF-8: fopen, CreateFileA, std::filesystem::path
  from std::string, argv.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
